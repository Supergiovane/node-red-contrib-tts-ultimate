{
  "name": "node-red-contrib-tts-ultimate",
  "version": "3.4.0",
  "description": "Transforms text into speech for Sonos, Google Cast, DLNA/UPnP and experimental AirPlay 2/HomePod playback, or generates audio files for third-party nodes. Supports Google, Google Cloud TTS, ElevenLabs, Voice.ai and custom audio files. Update of the popular SonosPollyTTS node.",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "verify:googletranslate-split": "node scripts/verify-googletranslate-split.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Supergiovane/node-red-contrib-tts-ultimate.git"
  },
  "keywords": [
    "node-red",
    "node-red-contrib",
    "google",
    "voice",
    "tts",
    "text-to-speech",
    "sonos",
    "chromecast",
    "google-cast",
    "nest",
    "dlna",
    "upnp",
    "airplay",
    "airplay2",
    "homepod",
    "IOT",
    "speech",
    "audio",
    "ttsultimate",
    "sonospollytts",
    "neural",
    "elevenlabs",
    "voiceai",
    "smarthome",
    "home-automation"
  ],
  "node-red": {
    "nodes": {
      "ttsultimate": "ttsultimate/ttsultimate.js",
      "ttsultimate-config": "ttsultimate/ttsultimate-config.js",
      "ownfile": "ttsultimate/ownfileultimate.js"
    }
  },
  "author": {
    "name": "Massimo Saccani",
    "email": "maxsupergiovane@icloud.com",
    "url": "https://youtube.com/@maxsupervibe"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Supergiovane/node-red-contrib-tts-ultimate"
  },
  "homepage": "https://github.com/Supergiovane/node-red-contrib-tts-ultimate",
  "dependencies": {
    "@basmilius/apple-airplay": "0.13.4",
    "@basmilius/apple-audio-source": "0.13.4",
    "@basmilius/apple-common": "0.13.4",
    "@basmilius/apple-raop": "0.13.4",
    "@basmilius/apple-sdk": "0.13.4",
    "@google-cloud/text-to-speech": "4.2.2",
    "castv2-client": "^1.2.0",
    "elevenlabs": "0.18.0",
    "elevenlabs-node": "1.1.3",
    "formidable": "1.2.2",
    "multicast-dns": "^7.2.5",
    "sonos": "^1.14.3"
  },
  "devDependencies": {
    "eslint": ">=4.18.2",
    "eslint-config-google": "^0.7.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
